# ─────────────────────────────────────────────────────────────────────
#  Copy this to .env.local for local development:  cp env.example .env.local
#  NEVER commit .env.local. In production these live in the Vercel
#  dashboard, never in the repository.
# ─────────────────────────────────────────────────────────────────────

# ── Firebase web config ──────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app.
#
# None of these are secrets. A web API key identifies the project and
# grants nothing by itself; what any signed-in account may read or write
# is decided by firestore.rules on Google's servers. They are prefixed
# NEXT_PUBLIC_ because the browser genuinely needs them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase service account — REAL SECRETS ──────────────────────────
# Firebase console → Project settings → Service accounts →
# "Generate new private key". Copy the three values out of the JSON file
# and then delete the file; do not keep it in the project directory.
#
# These bypass firestore.rules completely. Used only by the weekly price
# cron and the seed script.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes and the literal \n sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Weekly price cron ────────────────────────────────────────────────
# Shared secret so only Vercel Cron can trigger the price job.
# Generate one with:  openssl rand -hex 32
CRON_SECRET=

# ── Site ─────────────────────────────────────────────────────────────
# Used to build magic-link redirects. Vercel sets VERCEL_URL itself, so
# this is mainly for local development and a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Price feed (optional) ────────────────────────────────────────────
# "manual" means prices are typed into the admin panel. The cron still
# runs and still reports which tickers are waiting for a price.
# Point this at an adapter in lib/prices/ once you have a real feed.
PRICE_PROVIDER=manual
PRICE_API_KEY=
PRICE_API_BASE_URL=

# ── App Check (optional) ──────────────────────────────────────────────
# The Firebase web config above is public by design, so anyone can point
# their own script at this project. firestore.rules still decides what
# such a request may do — that is the real defence — but App Check adds
# the question "did this come from the site at all".
#
# Switching it on is two steps, deliberately in this order:
#   1. Register the site under App Check in the Firebase console with a
#      reCAPTCHA v3 provider, and put the site key here. Browsers start
#      sending tokens; nothing is refused yet.
#   2. Watch the console's App Check metrics for a few days. Once
#      requests are arriving with valid tokens, turn on enforcement.
#
# Doing step 2 first locks out every real player.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# A developer machine has no reCAPTCHA standing. Register the token the
# browser console prints, under App Check → Apps → Manage debug tokens.
# This is an explicit bypass: never set it in production.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# ── Prices (GitHub Actions, not here) ─────────────────────────────────
# The weekly price job runs in GitHub Actions rather than as a Vercel
# cron, because a failed workflow emails you and a Vercel cron that stops
# running tells nobody. Set these as repository secrets, not as Vercel
# variables:
#
#   SITE_URL      https://your-deployment.vercel.app
#   CRON_SECRET   the same value as CRON_SECRET above
#
# The price source is Yahoo, which needs no key. Until these two exist
# the workflow exits green and says so, and prices can be entered by hand
# from the admin panel.
